<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="RubiksCubeSimulator" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="RubiksCube" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="RubiksCube" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
			<Add directory="include" />
			<Add directory="src" />
		</Compiler>
		<Linker>
			<Add library="freeglut" />
			<Add library="opengl32" />
			<Add library="glu32" />
			<Add library="winmm" />
			<Add library="gdi32" />
			<Add directory="lib/x64" />
			<Add directory="lib" />
		</Linker>
		<Unit filename="src/Camera.cpp" />
		<Unit filename="src/Camera.h" />
		<Unit filename="src/Common.h" />
		<Unit filename="src/Cubie.cpp" />
		<Unit filename="src/Cubie.h" />
		<Unit filename="src/InputHandler.cpp" />
		<Unit filename="src/InputHandler.h" />
		<Unit filename="src/Renderer.cpp" />
		<Unit filename="src/Renderer.h" />
		<Unit filename="src/RubiksCube.cpp" />
		<Unit filename="src/RubiksCube.h" />
		<Unit filename="src/main.cpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
